# Envio de e-mail (rota de suporte)
# EMAIL_SENDER: conta Gmail que envia (faz login no SMTP)
# EMAIL_PASSWORD: senha de app dessa conta (https://myaccount.google.com/apppasswords)
# SUPPORT_EMAIL: quem recebe as mensagens de suporte (se vazio, usa EMAIL_SENDER)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_SENDER=
EMAIL_PASSWORD=
